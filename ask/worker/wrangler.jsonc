{
  // api.bsandova.com: proxy to the sitewitness server on Fly (see sitewitness.toml and deploy/).
  // Deploy: cd ask/worker && npx wrangler deploy   (secret ANTHROPIC_API_KEY set once with `wrangler secret put`)
  "name": "bsandova-ask",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "routes": [
    { "pattern": "api.bsandova.com", "custom_domain": true },
    { "pattern": "api.bsandova.com/*", "zone_name": "bsandova.com" }
  ],
  "vars": { "ALLOWED_ORIGINS": "https://bsandova.com,http://localhost:8791" },
  "observability": { "enabled": true }
}
